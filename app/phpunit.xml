<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="domaine">
            <directory>tests/pest/domaine</directory>
        </testsuite>
        <testsuite name="dto">
            <directory>tests/pest/dto</directory>
        </testsuite>
        <testsuite name="services">
            <directory>tests/pest/services</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
